{
    "$schema": "https://biomejs.dev/schemas/latest/schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120
    },
    "json": {
        "formatter": {
            "bracketSpacing": true
        }
    },
    "yaml": {
        "formatter": {
            "indentWidth": 2
        }
    }
}
